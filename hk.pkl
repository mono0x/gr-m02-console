amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["oxfmt"] {
    glob = "**/*.{js,jsx,ts,tsx,json,jsonc,md,yml,yaml}"
    check = "oxfmt --check {{ files }}"
    fix = "oxfmt --write {{ files }}"
  }
  ["oxlint"] = Builtins.ox_lint
  ["tsc"] = Builtins.tsc
  ["jactionlint"] {
    glob =
      List(
        ".github/workflows/*.{yml,yaml}",
        "**/action.{yml,yaml}",
        "mise.toml",
        "hk.pkl",
      )
    check = "mise exec -- jactionlint"
  }
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
}

local checkers = new Mapping<String, Step> {
  ...linters

  ["test"] {
    depends = List("oxfmt", "oxlint", "tsc")
    check = "pnpm run test"
  }
}

exclude = List("pnpm-lock.yaml")

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = checkers
  }
  ["post-tool-use"] {
    fix = true
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = checkers
  }
  ["check"] {
    steps = checkers
  }
}
