amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["oxfmt"] {
    glob = "**/*.{js,jsx,ts,tsx,json,jsonc,md,yml,yaml}"
    check = "oxfmt --check {{ files }}"
    fix = "oxfmt --write {{ files }}"
  }
  ["oxlint"] = Builtins.ox_lint
  ["tsc"] = Builtins.tsc
  ["jactionlint"] {
    glob =
      List(
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
        "**/action.{yml,yaml}",
      )
    batch = true
    diagnostic_format = "sarif"
    check = "mise exec -- jactionlint --format sarif {{files}}"
    check_diff = "mise exec -- hk util sarif-diff -- jactionlint --format sarif {{files}}"
    fix = "mise exec -- jactionlint --fix {{files}}"
  }
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
}

steps {
  ...linters

  ["test"] {
    depends = List("oxfmt", "oxlint", "tsc")
    check = "pnpm run test"
  }
}

exclude = List("pnpm-lock.yaml")

hooks {
  ["post-tool-use"] {
    fix = true
    steps = linters
  }
}
